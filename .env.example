# Model selection: use "deterministic" for offline FunctionModel execution,
# or provide a live model identifier such as:
#   openai:gpt-4o-mini
#   google-gla:gemini-2.5-flash
#   anthropic:claude-3-5-sonnet-latest
PROCUREMENT_MODEL=deterministic

# Optional LLM Provider API keys (required only when using live models)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
